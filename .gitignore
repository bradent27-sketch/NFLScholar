# Secrets - never commit. The Live Odds tab persists an Odds API key here in
# plaintext (see ui/tabs/live_odds.py) - HANDOFF.md explicitly warns about
# this file before sharing the folder.
.streamlit/odds_api_key.txt

# Imported Fantasy Football Advice data. This is paid subscription content
# belonging to FFA, imported for personal use via tools/har_extract.py +
# data/ffa_import.py - it should live on your machine, not in a git repo.
external_data/ffa_players.json

# FantasyPros cheat-sheet import (auction values, expert tiers, analyst
# notes). Same reasoning as the FFA import above: subscription content,
# imported for personal use, belongs on your machine rather than in a repo.
external_data/fantasypros_cheatsheet.json
external_data/fantasypros_players.json

# Raw browser HAR captures. A HAR carries every cookie and Authorization
# header the browser sent, so committing one publishes a live login session
# for whatever site was captured. Run it through tools/har_extract.py first
# and commit that output instead - it keeps the API payloads and copies no
# headers, cookies or POST bodies.
*.har

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Claude Code local session config (machine-specific tool permissions, not
# app config - .claude/launch.json, the actually-useful dev-server config,
# is intentionally still tracked).
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db

# Season-long book payloads the user saves from their own browser. Their
# data, not ours to redistribute - and this repo is public, which makes that
# a real distinction rather than a theoretical one. The trimmed fixtures
# under tests/fixtures are a handful of markets kept deliberately small
# enough to be a test case rather than a copy of anyone's board.
external_data/underdog_over_under_lines.json
external_data/prizepicks_projections.json
external_data/fanduel_nfl_page.json
external_data/pinnacle_nfl_matchups.json
external_data/draftkings_player_futures.json
# The weekly snapshot is a cache of someone else's live board, rewritten
# every Tuesday. Same reasoning, plus it would churn the diff weekly.
external_data/weekly_props_snapshot.json
