# Local Python virtualenv - never a repo artifact.
.venv/

# Scratch space for separate clones/checkouts of this same repo (used to
# work on multiple branches side by side). These have accidentally ended up
# committed as opaque gitlinks before (no .gitmodules, so `git add` on a
# nested .git folder just records a stale commit pointer) - ignoring the
# whole directory stops that from happening again.
.worktrees/

# Secrets - never commit. The Live Odds tab persists an Odds API key here in
# plaintext (see ui/tabs/live_odds.py) - HANDOFF.md explicitly warns about
# this file before sharing the folder.
.streamlit/odds_api_key.txt

# Same reasoning, for the FantasyPros API key (data/draft_sources.py's
# fetch_fantasypros_players). The usage file isn't a secret but is local
# runtime state (this month's call count against the 50/mo free-tier
# budget) with no reason to live in a public repo either.
.streamlit/fantasypros_api_key.txt
.streamlit/fantasypros_api_usage.json

# Streamlit's own secrets mechanism (st.secrets) - same file format Streamlit
# Community Cloud's Settings->Secrets panel writes server-side, so this one
# file works unchanged whether run locally or deployed there. Real API keys
# live here now (data.draft_sources.get_fantasypros_api_key checks this
# first); .streamlit/secrets.toml.example is the committed template showing
# the expected shape with no real key in it.
.streamlit/secrets.toml

# A reviewed, sanitized FFA dataset may be versioned at
# external_data/ffa_players.json. Do not add credentials, cookies, tokens,
# passwords, or raw browser captures to that file or any other tracked file.

# FantasyPros cheat-sheet import (auction values, expert tiers, analyst
# notes). These remain local-only subscription content.
external_data/fantasypros_cheatsheet.json
external_data/fantasypros_players.json

# Raw browser HAR captures. A HAR carries every cookie and Authorization
# header the browser sent, so committing one publishes a live login session
# for whatever site was captured. Never commit a raw HAR. Extract only a
# reviewed, sanitized dataset; a versioned FFA snapshot is permitted, but
# credentials, cookies, headers, and raw POST bodies are not.
*.har

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Claude Code local session config (machine-specific tool permissions, not
# app config - .claude/launch.json, the actually-useful dev-server config,
# is intentionally still tracked).
.claude/settings.local.json

# OS cruft
.DS_Store
Thumbs.db

# Season-long book payloads the user saves from their own browser. Their
# data, not ours to redistribute - and this repo is public, which makes that
# a real distinction rather than a theoretical one. The trimmed fixtures
# under tests/fixtures are a handful of markets kept deliberately small
# enough to be a test case rather than a copy of anyone's board.
external_data/underdog_over_under_lines.json
external_data/prizepicks_projections.json
external_data/fanduel_nfl_page.json
external_data/pinnacle_nfl_matchups.json
external_data/draftkings_player_futures.json
# The weekly snapshot is a cache of someone else's live board, rewritten
# every Tuesday. Same reasoning, plus it would churn the diff weekly.
external_data/prizepicks_weekly_projections.json
external_data/draftkings_weekly_props.json
external_data/weekly_props_snapshot.json

# Locally saved public depth-chart exports and the normalized personal-use
# snapshot derived from them.  The app can import these from the Depth Charts
# tab, but raw browser exports / regularly refreshed source snapshots should
# not churn a public repository.
external_data/ourlads_depth_charts/
external_data/ourlads_depth_charts.csv
external_data/ourlads_depth_chart_key.txt

# Weekly PFF alignment exports are locally licensed source material.  Keep
# the small manifest/provenance record reviewable if desired, but never stage
# the raw subscription reports by accident when preparing a public push.
pff_imports/*/weekly/

# Optional manual Week-1 availability decisions. This is personal runtime
# state, not a public source file; the code supplies an empty-safe loader.
data/availability_overrides.csv
