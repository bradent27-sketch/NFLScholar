# Copy this file to .streamlit/secrets.toml (or paste its contents into your
# Streamlit Community Cloud app's Settings -> Secrets panel) and fill in your
# real key below. secrets.toml itself is gitignored - never commit your real
# key. data.draft_sources.get_fantasypros_api_key() reads this before
# falling back to the manual entry field in the Draft HQ / Weekly Rankings
# tabs, so once this is set the UI just shows "using key from Streamlit
# secrets" and never asks for it again.
#
# Request a key at https://secure.fantasypros.com/api-keys/request/
FANTASYPROS_API_KEY = "your-fantasypros-api-key-here"
