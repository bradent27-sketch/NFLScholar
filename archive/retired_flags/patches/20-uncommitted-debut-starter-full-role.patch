+"""v2_debut_starter_full_role (2026-11-23, accuracy idea 6): a zero-game starter back from injury (not PUP / NFI) gets his
+full active role, as a suspension return does."""
+import os
+import sys
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+pd.options.mode.string_storage = "python"
+
+import data.historical_availability as ha  # noqa: E402
+import data.weekly_projections as wp  # noqa: E402
+
+
+def key(name):
+    return wp.clean_name_exact(pd.Series([name])).iloc[0]
+
+
+def _rosters(rows):
+    return pd.DataFrame(rows, columns=['season', 'week', 'team', 'full_name', 'status', 'status_description_abbr'])
+
+
+def test_flag_is_a_registered_candidate():
+    assert 'v2_debut_starter_full_role' in wp.MODEL_FEATURES
+    assert 'v2_debut_starter_full_role' not in wp.DEFAULT_FEATURES
+    assert wp.DEBUT_STARTER_MIN_ROLE == 0.70
+
+
+def test_pup_nfi_before_reads_the_three_codes_and_only_them():
+    r = _rosters([
+        [2024, 5, 'MIN', 'Pup Tight End', 'RES', 'R04'], [2024, 6, 'MIN', 'Pup Tight End', 'ACT', 'A01'],
+        [2024, 5, 'CAR', 'Nfi Back', 'RES', 'R05'],
+        [2024, 5, 'KC', 'Illness Back', 'RES', 'R27'],
+        [2024, 5, 'SF', 'Ir Back', 'RES', 'R01'],
+        [2024, 5, 'LA', 'Dtr Receiver', 'RES', 'R48'],
+        [2024, 5, 'NO', 'Suspended Back', 'RES', 'R40'],
+    ])
+    out = ha.pup_nfi_before(2024, 6, rosters=r)
+    assert out == {key('Pup Tight End'), key('Nfi Back'), key('Illness Back')}
+    # still on the list in his own week's row: not back yet
+    still = _rosters([[2024, 5, 'MIN', 'Pup Tight End', 'RES', 'R04'], [2024, 6, 'MIN', 'Pup Tight End', 'RES', 'R04']])
+    assert ha.pup_nfi_before(2024, 6, rosters=still) == set()
+    assert ha.pup_nfi_before(2024, 6, rosters=pd.DataFrame()) == set()
+
+
+def test_suspended_before_is_unchanged_by_the_shared_helper():
+    r = _rosters([[2023, 3, 'NO', 'Alvin Kamara', 'RES', 'R40'], [2023, 4, 'NO', 'Alvin Kamara', 'ACT', 'A01'],
+                  [2023, 3, 'MIN', 'Pup Tight End', 'RES', 'R04']])
+    assert ha.suspended_before(2023, 4, rosters=r) == {key('Alvin Kamara')}
+
+
+def test_mask_needs_a_starter_role_no_pup_nfi_and_availability():
+    names = pd.Series(['Starter', 'Pre Absence Starter', 'Part Timer', 'Pup Starter', 'Out Starter', 'No History'])
+    active = [0.86, 0.55, 0.62, 0.80, 0.90, np.nan]
+    pre_absence = [np.nan, 0.83, 0.65, 0.80, 0.90, np.nan]
+    avail = [1.0, 1.0, 1.0, 1.0, 0.0, 1.0]
+    mask = wp.debut_starter_return_mask(names, active, pre_absence, {key('Pup Starter')}, avail)
+    assert mask.tolist() == [True, True, False, False, False, False]
+    # no PUP / NFI set at all: only the role and availability decide
+    assert wp.debut_starter_return_mask(names, active, pre_absence, set(), avail).tolist() == \
+        [True, True, False, True, False, False]
+
+
+def test_a_marked_starter_gets_the_full_role_and_an_ineligible_one_nothing():
+    # whole ~0 (no game this season), active 0.86 over 15 prior games, same team; the third row changed teams
+    whole, active = np.array([0.0, 0.0, 0.0]), np.array([0.86, 0.86, 0.86])
+    args = dict(whole_season_share=whole, active_game_share=active, prior_games=np.array([15, 15, 15]),
+                prior_team=['BAL', 'BAL', 'ARI'], current_team=['BAL', 'BAL', 'KC'], pos='WR', return_details=True)
+    base, base_ok, _ = wp.restore_cold_start_returning_role_share(**args)
+    mask = wp.debut_starter_return_mask(['A', 'B', 'C'], active, [np.nan] * 3, set(), [1.0, 1.0, 1.0])
+    share, ok, reason = wp.restore_cold_start_returning_role_share(**args, full_recovery=mask & np.array([False, True, True]))
+    assert share[0] == base[0] and base[0] < 0.86                       # not marked: the partial pull
+    assert np.isclose(share[1], 0.86) and reason[1] == 'full active role restored'
+    assert share[2] == base[2] and not ok[2]                            # new team: never promoted
+    assert (ok == base_ok).all()
